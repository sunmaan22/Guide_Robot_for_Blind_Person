# 카카오 로컬 API (route_maker.py) - https://developers.kakao.com 에서 발급
KAKAO_REST_API_KEY=

# Picovoice Porcupine 웨이크워드 엔진 (wake_word_node.py) - https://console.picovoice.ai 에서 발급
PORCUPINE_ACCESS_KEY=

# 선택: 마이크 장치 인덱스 (arecord -l / python -m pyaudio 로 확인, 기본값 1)
MIC_DEVICE_INDEX=1

# 선택: TTS 출력용 PulseAudio 싱크 이름 (pactl list short sinks 로 확인)
TTS_AUDIO_SINK=bluez_sink.XX_XX_XX_XX_XX_XX.a2dp_sink
